Practical - 7: Web Crawling

import requests
import time
from bs4 import BeautifulSoup
from urllib.parse import urljoin

start_url = "https://www.python.org/"
visited = set()
queue = [start_url]
index = {}

max_pages = 3

while queue and len(visited) < max_pages:
    url = queue.pop(0)

    if url in visited:
        continue

    response = requests.get(url)

    if response.status_code == 200:
        soup = BeautifulSoup(response.text, "html.parser")

        text = soup.get_text(" ", strip=True)[:120]
        index[url] = text
        print("Indexed:", url)

        for link in soup.find_all("a", href=True):
            href = link["href"]

            if "#" in href:   # skip page fragments
                continue

            full_link = urljoin(url, href)

            if full_link not in visited and full_link not in queue:
                queue.append(full_link)

    visited.add(url)
    time.sleep(1)

print("\nFinal Index:\n")

for url, text in index.items():
    print(url)
    print(text)
    print()

Practical - 8: PageRank Algorithm

import requests
from bs4 import BeautifulSoup
from urllib.parse import urljoin
import numpy as np

start_url = "https://www.python.org/"
pages = []
links = {}

# -------- Crawl few pages to build graph --------
response = requests.get(start_url)
soup = BeautifulSoup(response.text, "html.parser")

for link in soup.find_all("a", href=True)[:5]:
    url = urljoin(start_url, link["href"]).split("#")[0]
    pages.append(url)

pages = list(set(pages))

for page in pages:
    links[page] = []

# -------- Simple PageRank Calculation --------
n = len(pages)
rank = {page: 1/n for page in pages}
d = 0.85

for _ in range(10):
    new_rank = {}
    for page in pages:
        s = 0
        for p in pages:
            if page in links[p] and len(links[p]) > 0:
                s += rank[p] / len(links[p])
        new_rank[page] = (1-d)/n + d*s
    rank = new_rank

# -------- Output --------
print("\nPageRank Results:\n")

for page, score in rank.items():
    print(page)
    print("Rank:", round(score,4))
    print()

