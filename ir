Practical - 3: Spelling Correction

def editDistRec(s1, s2, m, n):
    if m == 0:
        return n
    if n == 0:
        return m

    if s1[m-1] == s2[n-1]:
        return editDistRec(s1, s2, m-1, n-1)

    return 1 + min(
        editDistRec(s1, s2, m, n-1),    # Insert
        editDistRec(s1, s2, m-1, n),    # Remove
        editDistRec(s1, s2, m-1, n-1)   # Replace
    )

def editDistance(s1, s2):
    return editDistRec(s1, s2, len(s1), len(s2))


if __name__ == "__main__":
    s1 = "kitten"
    s2 = "sitting"

    print("String 1:", s1)
    print("String 2:", s2)
    print("Edit Distance is", editDistance(s1, s2))

