from sklearn.feature_extraction.text import TfidfVectorizer
import numpy as np

# Sample document
text = """
Information Retrieval is the process of obtaining relevant information from large collections of data.
Search engines like Google use information retrieval techniques to provide accurate results.
Text summarization helps in reducing long documents into shorter summaries.
Question answering systems retrieve specific answers from a document.
"""

# ---------- TEXT SUMMARIZATION ----------
sentences = text.split(". ")

vectorizer = TfidfVectorizer()
X = vectorizer.fit_transform(sentences)
scores = np.sum(X.toarray(), axis=1)
summary_index = np.argmax(scores)

print("\nSummary Sentence:")
print(sentences[summary_index])

# ---------- QUESTION ANSWERING ----------
question = "What is information retrieval?"

for sentence in sentences:
    if "information retrieval" in sentence.lower():
        answer = sentence
        break

